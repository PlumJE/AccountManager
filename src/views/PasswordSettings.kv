<PasswordSettings>:
    on_kv_post: self.initSettings()
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: '비밀번호 설정'
            font_name: 'Nanum'
            font_size: '30dp'
            size_hint_y: None
        BoxLayout:
            Label:
                text: '필수문자 : '
                font_name: 'Nanum'
            GridLayout:
                cols: 2
                ToggleButton:
                    id: upperToggle
                    text: '대문자'
                    font_name: 'Nanum'
                    state: 'down'
                ToggleButton:
                    id: lowerToggle
                    text: '소문자'
                    font_name: 'Nanum'
                    state: 'down'
                ToggleButton:
                    id: numberToggle
                    text: '숫자'
                    font_name: 'Nanum'
                    state: 'down'
                ToggleButton:
                    id: specialToggle
                    text: '특수문자'
                    font_name: 'Nanum'
                    state: 'down'
        BoxLayout:
            Label:
                text: '제외문자 : '
                font_name: 'Nanum'
            TextInput:
                id: excludeTextInput
                hint_text: '제외할 문자를 입력하세요'
                font_name: 'Nanum'
        BoxLayout:
            size_hint_y: None
            Label:
                text: '길이 : '
                font_name: 'Nanum'
            TextInput:
                id: lengthTextInput
                text: '10'
                hint_text: '비밀번호 길이를 입력하세요'
                font_name: 'Nanum'
        BoxLayout:
            size_hint_y: None
            Button:
                text: '저장'
                font_name: 'Nanum'
                on_press: root.saveSettings()
            Button:
                text: '취소'
                font_name: 'Nanum'
                on_press: root.manager.current = 'accountList'
