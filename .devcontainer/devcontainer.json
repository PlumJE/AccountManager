{
  "name": "Kivy Buildozer Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": {
      "CONTAINER_NAME": "account-manager"
    }
  },
  "workspaceFolder": "/home/user/account-manager",
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/user/account-manager,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ]
    }
  }
}
